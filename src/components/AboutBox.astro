---
import { marked } from "marked";
import { chrome } from "../data/site.config";

const aboutHtml = marked.parse(chrome.aboutTextMarkdown.trim(), { async: false }) as string;
---

<div class="about-box">
  <div class="label">{chrome.aboutTitle}</div>
  <div class="prose" set:html={aboutHtml} />
</div>

<style>
  .about-box {
    background: #111214;
    border: 1px solid #232527;
    border-radius: 10px;
    padding: 1rem 1.15rem;
    max-width: 320px;
  }

  .label {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--secondary-text);
    margin-bottom: 0.5rem;
  }

  .prose {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text);
  }

  .prose :global(p) {
    margin: 0 0 0.6rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    color: var(--ring);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 700;
  }
</style>
