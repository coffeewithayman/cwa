---
import { centerNode, nodes, theme } from "../data/site.config";

const nameLine = centerNode.name.replace(/\n/g, " ");
const extraLine = centerNode.extraText?.replace(/\n/g, " ");
---

<div class="mobile-list">
  <div class="center-card" style={`--ring: ${theme.centerRingColor};`}>
    <div class="name">{nameLine}</div>
    <div class="title">{centerNode.title}</div>
    {extraLine && <p class="extra">{extraLine}</p>}
    {centerNode.cta && (
      <a class="cta" href={centerNode.cta.href} target="_blank" rel="noopener noreferrer">
        {centerNode.cta.label}
      </a>
    )}
  </div>

  <ul>
    {nodes.map((node) => {
      const ring = node.ringColor ?? theme.defaultRingColor;
      if (node.children && node.children.length > 0) {
        return (
          <li class="has-children">
            <details>
              <summary style={`--ring: ${ring};`}>
                <span class="dot"></span>
                <span class="text">
                  <span class="main">{node.mainText.replace(/\n/g, " ")}</span>
                  <span class="secondary">{node.secondaryText}</span>
                </span>
                <span class="chevron" aria-hidden="true">⌄</span>
              </summary>
              <p class="tooltip">{node.tooltip}</p>
              <ul class="sub-list">
                {node.children.map((child) => {
                  const childRing = child.ringColor ?? ring;
                  return (
                    <li>
                      <a href={child.href} target="_blank" rel="noopener noreferrer" style={`--ring: ${childRing};`}>
                        <span class="dot"></span>
                        <span class="text">
                          <span class="main">{child.mainText.replace(/\n/g, " ")}</span>
                          <span class="secondary">{child.secondaryText}</span>
                        </span>
                        <span class="arrow">↗</span>
                      </a>
                      <p class="tooltip">{child.tooltip}</p>
                    </li>
                  );
                })}
              </ul>
            </details>
          </li>
        );
      }
      return (
        <li>
          <a href={node.href} target="_blank" rel="noopener noreferrer" style={`--ring: ${ring};`}>
            <span class="dot"></span>
            <span class="text">
              <span class="main">{node.mainText.replace(/\n/g, " ")}</span>
              <span class="secondary">{node.secondaryText}</span>
            </span>
            <span class="arrow">↗</span>
          </a>
          <p class="tooltip">{node.tooltip}</p>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .mobile-list {
    display: none;
  }

  @media (max-width: 700px) {
    .mobile-list {
      display: block;
    }
  }

  .center-card {
    text-align: center;
    padding: 1.25rem 1rem;
    border: 1.5px solid var(--ring);
    border-radius: 12px;
    background: #111214;
    margin-bottom: 1.25rem;
  }

  .name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
  }

  .title {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--ring);
    letter-spacing: 0.03em;
  }

  .extra {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--secondary-text);
    line-height: 1.4;
  }

  .cta {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--cta-bg);
    color: var(--cta-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #232527;
    border-radius: 10px;
    background: #111214;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--ring);
    flex-shrink: 0;
  }

  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    gap: 0.1rem;
  }

  .main {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .secondary {
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    color: var(--ring);
  }

  .arrow {
    color: var(--secondary-text);
    font-size: 0.8rem;
  }

  .tooltip {
    margin: 0.3rem 0 0 1.6rem;
    font-size: 0.68rem;
    color: var(--secondary-text);
    overflow-wrap: break-word;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #232527;
    border-radius: 10px;
    background: #111214;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    color: var(--secondary-text);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }

  details[open] > summary .chevron {
    transform: rotate(180deg);
  }

  details[open] > summary {
    border-color: var(--ring);
  }

  .sub-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 1.5px solid #232527;
  }

  .sub-list li a {
    padding: 0.6rem 0.75rem;
  }

  .sub-list .main {
    font-size: 0.78rem;
  }
</style>
