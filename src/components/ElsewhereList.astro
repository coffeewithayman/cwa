---

<div class="elsewhere-box">
  <div class="label">{chrome.elsewhereTitle}</div>
  <ul class="links">
    {
      chrome.elsewhereLinks.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="link-left">
              <span class="icon" set:html={icons[link.icon] ?? ""} />
              <span>{link.label}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .elsewhere-box {
    background: #111214;
    border: 1px solid #232527;
    border-radius: 10px;
    padding: 1rem 1.15rem;
    max-width: 320px;
  }

  .label {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--secondary-text);
    margin-bottom: 0.5rem;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text);
    padding: 0.15rem 0;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .link-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .icon {
    display: inline-flex;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--secondary-text);
    transition: color 0.15s ease;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .links a::after {
    content: "↗";
    color: var(--secondary-text);
    font-size: 0.7rem;
    margin-left: 0.5rem;
    transition: color 0.15s ease;
  }

  .links a:hover {
    color: var(--ring);
  }

  .links a:hover .icon,
  .links a:hover::after {
    color: var(--ring);
  }
</style>
