---
import { marked } from "marked";
import { chrome } from "../data/site.config";

const linksHtml = marked.parse(chrome.elsewhereLinksMarkdown.trim(), { async: false }) as string;
---

<div class="elsewhere-box">
  <div class="label">{chrome.elsewhereTitle}</div>
  <div class="links" set:html={linksHtml} />
</div>

<style>
  .elsewhere-box {
    background: #111214;
    border: 1px solid #232527;
    border-radius: 10px;
    padding: 1rem 1.15rem;
    max-width: 320px;
  }

  .label {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--secondary-text);
    margin-bottom: 0.5rem;
  }

  .links :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .links :global(a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text);
    padding: 0.15rem 0;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .links :global(a::after) {
    content: "↗";
    color: var(--secondary-text);
    font-size: 0.7rem;
    margin-left: 0.5rem;
    transition: color 0.15s ease;
  }

  .links :global(a:hover) {
    color: var(--ring);
  }

  .links :global(a:hover::after) {
    color: var(--ring);
  }
</style>
