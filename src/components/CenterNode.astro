---
import { centerNode, theme } from "../data/site.config";

const nameLines = centerNode.name.split("\n");
const extraLines = centerNode.extraText?.split("\n") ?? [];
---

<div
  class="center-node"
  style={`--size: ${theme.centerNodeSize}px; --ring: ${theme.centerRingColor};`}
>
  <div class="glow"></div>
  <div class="ring">
    <div class="content">
      <div class="name">
        {nameLines.map((line) => <span>{line}</span>)}
      </div>
      <div class="title">{centerNode.title}</div>
      {extraLines.length > 0 && (
        <div class="extra">
          {extraLines.map((line) => <span>{line}</span>)}
        </div>
      )}
      {centerNode.cta && (
        <a class="cta" href={centerNode.cta.href} target="_blank" rel="noopener noreferrer">
          {centerNode.cta.label}
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .center-node {
    position: relative;
    width: var(--size);
    height: var(--size);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glow {
    position: absolute;
    inset: -140%;
    background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .ring {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1.5px solid var(--ring);
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 0.5rem;
  }

  .name {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .title {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--ring);
  }

  .extra {
    font-size: 0.62rem;
    color: var(--secondary-text);
    line-height: 1.3;
  }

  .cta {
    margin-top: 0.15rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    background: var(--cta-bg);
    color: var(--cta-text);
    font-size: 0.65rem;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }

  .cta:hover {
    opacity: 0.85;
  }

  @media (max-width: 700px) {
    .name {
      font-size: 1.3rem;
    }

    .title {
      font-size: 0.8rem;
    }

    .extra {
      font-size: 0.76rem;
    }

    .cta {
      font-size: 0.8rem;
    }
  }
</style>
