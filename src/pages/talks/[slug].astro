---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { clock, formatLabel, humanDuration, linkAt, youtubeId } from "../../lib/talks";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks.filter((t) => t.data.hasTranscript).map((t) => ({ params: { slug: t.data.slug }, props: { talk: t.data } }));
}

const { talk } = Astro.props;
const transcript = (await getEntry("transcripts", talk.slug))?.data;
const ytId = youtubeId(talk.url);
const start = transcript?.turns[0]?.start ?? 0;
const embed = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}?start=${Math.floor(start)}&rel=0` : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: talk.title,
  description: talk.summary ?? `${formatLabel(talk.format)} by Ayman Elsawah${talk.event ? ` — ${talk.event}` : ""}`,
  uploadDate: talk.date ?? undefined,
  thumbnailUrl: talk.thumbnail ?? undefined,
  duration: talk.duration ? `PT${Math.round(talk.duration)}S` : undefined,
  contentUrl: talk.url ?? undefined,
  embedUrl: embed ?? undefined,
  transcript: transcript?.turns.map((t) => t.lines.map((l) => l.text).join(" ")).join("\n"),
};
---

<Layout title={`${talk.title} — Ayman Elsawah`} description={talk.summary ?? `Transcript: ${talk.title}`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main>
    <header class="top">
      <a href="/talks/" class="back">← All talks</a>
    </header>

    <h1>{talk.title}</h1>
    <p class="meta">
      {[talk.date, formatLabel(talk.format), talk.event, humanDuration(talk.duration)].filter((x) => x && x !== "—").join(" · ")}
      {talk.url && <> · <a href={talk.url} target="_blank" rel="noopener noreferrer">{talk.platform} ↗</a></>}
    </p>
    {talk.topics.length > 0 && (
      <p class="tags">{talk.topics.map((t) => <a class="tag" href={`/talks/?topic=${encodeURIComponent(t)}`}>{t}</a>)}</p>
    )}
    {talk.summary && <p class="summary">{talk.summary}</p>}

    {embed && (
      <div class="player">
        <iframe
          data-player
          data-base={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0`}
          src={embed}
          title={talk.title}
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    )}

    {transcript && (
      <section class="transcript" aria-label="Transcript">
        <h2>Transcript</h2>
        {transcript.scope === "ayman" && (
          <p class="note">Only Ayman's parts of this conversation are included, with the question before each answer for context.</p>
        )}
        {transcript.turns.map((turn) => {
          // Timestamp at the start of each turn, then roughly every 30 s inside long turns.
          let lastShown = -Infinity;
          const startHref = linkAt(talk.url, turn.start);
          return (
            <div class:list={["turn", { context: turn.context, ayman: turn.speaker === "Ayman" }]}>
              <div class="who">
                {turn.speaker}
                {startHref ? (
                  <a class="ts start" href={startHref} data-t={Math.floor(turn.start)} target="_blank" rel="noopener noreferrer">{clock(turn.start)}</a>
                ) : (
                  <span class="ts start">{clock(turn.start)}</span>
                )}
              </div>
              <p>
                {turn.lines.map((line, i) => {
                  const show = i > 0 && line.t - lastShown >= 30;
                  if (i === 0 || show) lastShown = line.t;
                  const href = show ? linkAt(talk.url, line.t) : null;
                  return (
                    <span class="line">
                      {show && (href ? (
                        <a class="ts" href={href} data-t={Math.floor(line.t)} target="_blank" rel="noopener noreferrer">{clock(line.t)}</a>
                      ) : (
                        <span class="ts">{clock(line.t)}</span>
                      ))}
                      {show && " "}{line.text}{" "}
                    </span>
                  );
                })}
              </p>
            </div>
          );
        })}
      </section>
    )}
  </main>
</Layout>

<script>
  // With an embedded player, timestamps seek the player instead of leaving the page.
  const player = document.querySelector<HTMLIFrameElement>("[data-player]");
  if (player) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>("a.ts[data-t]")) {
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        player.src = `${player.dataset.base}&start=${a.dataset.t}&autoplay=1`;
        player.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  }
</script>

<style>
  main {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 4rem;
  }

  .top {
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--secondary-text);
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--text);
  }

  h1 {
    font-size: 1.7rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .meta {
    color: var(--secondary-text);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }

  .meta a,
  .ts {
    color: var(--center-ring);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 1rem;
  }

  .tag {
    font-size: 0.72rem;
    color: var(--secondary-text);
    border: 1px solid #2a2d30;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  .tag:hover {
    color: var(--text);
    border-color: var(--center-ring);
  }

  .summary {
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0 2rem;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary-text);
    font-weight: 500;
  }

  .note {
    font-size: 0.8rem;
    color: var(--secondary-text);
  }

  .turn {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #1c1e20;
  }

  .who {
    font-size: 0.75rem;
    color: var(--secondary-text);
    padding-top: 0.2rem;
  }

  .ts.start {
    display: block;
    margin-top: 0.2rem;
  }

  .turn.ayman .who {
    color: var(--center-ring);
  }

  .turn p {
    margin: 0;
    line-height: 1.7;
  }

  .turn.context p {
    color: var(--secondary-text);
    font-style: italic;
  }

  .ts {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  .ts:hover {
    opacity: 1;
  }

  @media (max-width: 700px) {
    main {
      padding: 1rem 1rem 3rem;
    }

    .turn {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .ts.start {
      display: inline;
      margin-left: 0.5rem;
    }
  }
</style>
