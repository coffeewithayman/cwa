---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { press } from "../data/press";

const items = [...press].sort((a, b) => b.date.localeCompare(a.date));

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
/** "2019-08-07" / "2019-08" -> "Aug 2019" ; "2019" -> "2019" */
function displayDate(iso: string): string {
  const [y, m] = iso.split("-");
  return m ? `${months[Number(m) - 1]} ${y}` : y;
}
---

<Layout
  title="Press & Writing — Ayman Elsawah"
  description="Articles, book chapters and other written coverage featuring Ayman Elsawah."
>
  <main>
    <header class="top">
      <a href="/" class="back">← Ayman Elsawah</a>
      <span>press &amp; writing</span>
    </header>

    <h1>Press &amp; Writing</h1>
    <p class="lede">
      Articles I’ve been quoted in and books I’ve contributed to. For talks, interviews and podcasts, see <a
        href="/talks/">Talks &amp; Videos</a>.
    </p>

    <ul class="gallery">
      {items.map((item, i) => (
        <li class="card">
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="card-link">
            <div class:list={["media", item.imageFit]}>
              {item.imageFit === "cover" && (
                <Image src={item.image} alt="" aria-hidden="true" class="backdrop" width={240} loading={i < 2 ? "eager" : "lazy"} />
              )}
              <Image
                src={item.image}
                alt={item.imageAlt}
                class="art"
                widths={item.imageFit === "cover" ? [240, 480] : [480, 800, 1200]}
                sizes={item.imageFit === "cover" ? "240px" : "(max-width: 760px) 100vw, 560px"}
                loading={i < 2 ? "eager" : "lazy"}
              />
            </div>
            <div class="body">
              <p class="meta mono">
                <span class="kind">{item.kind}</span>
                <span>{item.outlet}</span>
                <span class="muted">{displayDate(item.date)}</span>
              </p>
              <h2>{item.title}</h2>
              <p class="role mono">{item.role}</p>
              <p class="blurb">{item.blurb}</p>
              {item.quote && <blockquote>“{item.quote}”</blockquote>}
              <span class="cta mono">{item.linkLabel} ↗</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2.5rem 4rem;
  }

  .mono,
  .top {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  .top {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--secondary-text);
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--text);
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  .lede {
    color: var(--secondary-text);
    max-width: 60ch;
    line-height: 1.5;
    margin: 0 0 2.5rem;
  }

  .lede a {
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }

  .lede a:hover {
    color: var(--center-ring);
    border-color: currentColor;
  }

  /* --- gallery ------------------------------------------------------------ */
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1.5rem;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #111214;
    border: 1px solid #232527;
    border-radius: 12px;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .card-link:hover,
  .card-link:focus-visible {
    border-color: var(--ring);
    transform: translateY(-3px);
  }

  .card-link:focus-visible {
    outline: 2px solid var(--center-ring);
    outline-offset: 3px;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0d0e10;
  }

  .media :global(img) {
    display: block;
  }

  .media.wide :global(.art) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-link:hover .media.wide :global(.art) {
    transform: scale(1.03);
  }

  /* Portrait book covers: whole cover centered over a blurred copy of itself. */
  .media.cover :global(.backdrop) {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    filter: blur(28px) saturate(1.2) brightness(0.45);
  }

  .media.cover :global(.art) {
    position: relative;
    height: 86%;
    width: auto;
    margin: 4% auto 0;
    border-radius: 3px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
    transition: transform 0.4s ease;
  }

  .card-link:hover .media.cover :global(.art) {
    transform: translateY(-4px) rotate(-1deg);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.25rem 1.3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin: 0 0 0.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .kind {
    color: var(--center-ring);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  .muted {
    color: var(--secondary-text);
  }

  h2 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin: 0 0 0.4rem;
    text-wrap: balance;
  }

  .role {
    font-size: 0.7rem;
    color: var(--secondary-text);
    margin: 0 0 0.85rem;
  }

  .blurb {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #c8c8c8;
    margin: 0 0 1rem;
  }

  blockquote {
    margin: 0 0 1rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--center-ring);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.5;
  }

  .cta {
    margin-top: auto;
    font-size: 0.72rem;
    color: var(--secondary-text);
    transition: color 0.15s ease;
  }

  .card-link:hover .cta {
    color: var(--center-ring);
  }

  @media (max-width: 760px) {
    main {
      padding: 1rem 1rem 3rem;
    }

    h1 {
      font-size: 1.6rem;
    }

    .lede {
      margin-bottom: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link,
    .media :global(.art) {
      transition: none;
    }

    .card-link:hover,
    .card-link:hover .media :global(.art) {
      transform: none;
    }
  }
</style>
