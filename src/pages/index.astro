---
import Layout from "../layouts/Layout.astro";
import NetworkGraph from "../components/NetworkGraph.astro";
import AboutBox from "../components/AboutBox.astro";
import ElsewhereList from "../components/ElsewhereList.astro";
import { chrome, nodes } from "../data/site.config";
---

<Layout>
  <main>
    <header>
      <span class="label">{chrome.headerLabel}</span>
      <span class="node-count">{nodes.length} nodes · click to explore</span>
    </header>

    <section class="graph-section">
      <NetworkGraph />
    </section>

    <footer class="panels">
      <AboutBox />
      <ElsewhereList />
    </footer>

    <div class="copyright">
      <span>{chrome.footerText}</span>
      <span>{chrome.footerRight}</span>
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 2.5rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--secondary-text);
    margin-bottom: 2rem;
  }

  header span {
    min-width: 0;
  }

  .node-count {
    text-align: right;
  }

  .graph-section {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
  }

  .panels {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .copyright {
    display: flex;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--secondary-text);
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #1c1e20;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .copyright span {
    min-width: 0;
  }

  @media (max-width: 700px) {
    .panels {
      flex-direction: column;
    }

    .graph-section {
      justify-content: flex-start;
    }
  }
</style>
